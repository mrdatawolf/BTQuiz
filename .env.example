# Copy this file to .env to override the defaults below.

# Network interface to bind to.
# 0.0.0.0 binds to every local network interface, so the kiosk touch screen,
# a laptop, and a phone on the same network can all reach it.
# Use 127.0.0.1 instead to restrict access to just this machine.
IP=0.0.0.0

# Port the BTQuiz server listens on.
PORT=4444
